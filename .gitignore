node_modules
.DS_Store
.pnpm-store
.env*
*.log

# Claude Codeの個人設定
/.claude/settings.local.json

# 記事・下書きのコンテンツは頻繁に変わるため追跡対象外
# (記事はWeb版エディタで管理、下書きはローカルのみ)
# ディレクトリ構造自体はリポジトリ上に残す
/articles/*
!/articles/.gitkeep
/drafts/*
!/drafts/.gitkeep

# エクスポートデータなどの生データは個人情報を含みうるため追跡対象外
/raw/*
!/raw/.gitkeep

# Obsidian Vaultのうち環境ごとに変わるファイル
/vault/.obsidian/workspace.json
/vault/.obsidian/workspace-mobile.json
/vault/.trash/
